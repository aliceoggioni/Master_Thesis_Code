      cindex_uno_cv_e = concordance(fit_cox_cv_e, timewt="n/G2")$concordance
      
    }
    
    
    ########### Sum Score
  
    c_index_cv_sum <- cindex_sum
    tdauc_cv_sum   <- auc_s
    brier_cv_sum = brier_s
    cindex_uno_cv_s = cindex_uno_s
    
    results_table = data.frame(
        R_C  = cindex_r[1],   R_C_cv = c_index_cv_r[1], 
        R_auc  = auc_r,       R_auc_cv = tdauc_cv_r,
        R_B = brier_r,        R_B_cv = brier_cv_r,
        R_unoC = cindex_uno_r, R_unoC_cv = cindex_uno_cv_r,
      
