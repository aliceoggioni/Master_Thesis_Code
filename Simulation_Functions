        L_B = brier_l,        L_B_cv = brier_cv_l,
        L_unoC = cindex_uno_l, L_unoC_cv = cindex_uno_cv_l,
      
        E_C  = cindex_e[1],   E_C_cv = c_index_cv_e[1],
