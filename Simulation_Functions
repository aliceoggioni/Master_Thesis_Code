# Two-step cox function

```{r}
twostepcox_slopes = function(long_df, surv_df, n_folds = 5, 
                             analysis_name = "", 
                             verbose = FALSE, linear = TRUE){
  
  ######## Flipping for PoA
  maxcol_bio = ncol(long_df)
  long_df_scaled <- long_df |>
  mutate(across(starts_with("bio"), ~ as.numeric(scale(.x))))
  for(i in 4:maxcol_bio){
    corr = cor(long_df_scaled[,i], long_df_scaled$age, use = "complete.obs")
    sign_flip = if (corr > 0) 1 else -1
    long_df_scaled[,i] = long_df_scaled[,i] * sign_flip
  }
  
  
  ######## LMMs for PoA
  slopespoa = data.frame(id = unique(long_df_scaled$id))
  for(i in 4:maxcol_bio){
    name = colnames(long_df_scaled)[i]
    f <- formula(paste(name, "~ (age|id) + age"))
    model <- lmer(f, data=long_df_scaled)
    raneftab = ranef(model)$id
    raneftab[,1] = NULL
    colnames(raneftab) = name
    raneftab$id = as.integer(rownames(raneftab))
    slopespoa = full_join(raneftab, slopespoa, by = c("id" = "id"))
  }
  
  slopespoacomplete = slopespoa[complete.cases(slopespoa),]
  slopesmatrixpoa  = as.matrix(slopespoacomplete[,c(1, 3:maxcol_bio-2)])
  slopespoaid  = as.data.frame(slopesmatrixpoa)
  slopespoaid$id = slopespoacomplete$id
  
  
  ######## LMMs
  maxcol_bio = ncol(long_df)
  slopestable = data.frame(id = unique(long_df$id))
  for(i in 4:maxcol_bio){
    name = colnames(long_df)[i]
    if(linear == TRUE){
      f <- formula(paste(name, "~ (age|id) + age"))
    } else {
      f <- formula(paste(name, "~ (age|id) + bs(age)"))
    }
    suppressWarnings({model <- lmer(f, data=long_df)})
    
    raneftab = ranef(model)$id
    raneftab[,1] = NULL
    colnames(raneftab) = name
    raneftab$id = as.integer(rownames(raneftab))
    slopestable = full_join(raneftab, slopestable, by = "id")
  }
  slopestablecomplete = slopestable[complete.cases(slopestable),]

  if (nrow(slopestablecomplete) == 0) {
    stop("All rows dropped by complete.cases()")
  }
  slopesmatrix = as.matrix(slopestablecomplete[,c(1, 3:(maxcol_bio-2))])
  slopematscaled = scale(slopesmatrix)
  slopestableid = as.data.frame(slopematscaled)
  slopestableid$id = slopestablecomplete$id
  
  
  ######## Survival Model
  survival_table = left_join(slopestableid, surv_df, by = c("id" = "id"))
  survival_table_poa = left_join(slopespoaid, surv_df, by = c("id" = "id"))
  n_deaths = sum(survival_table$Death, na.rm = T)
  entryage = long_df |> group_by(id) |> summarise(Age_Entry = max(age, na.rm = TRUE))
  survival_table = left_join(survival_table, entryage, by = c("id" = "id"))
  survival_table_poa = left_join(survival_table_poa, entryage, by = c("id" = "id"))
  surv_model = Surv(survival_table$Age_Entry, survival_table$Age_Death,
                  survival_table$Death)
  surv_model_poa = Surv(survival_table_poa$Age_Entry, survival_table_poa$Age_Death,
                  survival_table_poa$Death)
  
  
  ######## Models
  model_r =  suppressWarnings({cv.glmnet(slopematscaled, surv_model, 
                          family = "cox", alpha = 0)})

  model_l =  suppressWarnings({cv.glmnet(slopematscaled, surv_model, 
                          family = "cox", alpha = 1)})
  
  model_e =  suppressWarnings({cv.glmnet(slopematscaled, surv_model, 
                          family = "cox", alpha = 0.5)})
  
  
  ######## Apparent Measures
  
  ######## TRUE
  #### C-Index
  fit_lp_t <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_std, 
                       data = survival_table)
  true_c = summary(fit_lp_t)$concordance
  
  #### tdAUC
  t_pred <- median(survival_table$Age_Death[survival_table$Death == 1])
  
  roc_obj_t <- survivalROC(Stime = survival_table$Age_Death, 
                         status = survival_table$Death,
                         entry = survival_table$Age_Entry,
                         marker = survival_table$linpred_std, 
                         predict.time = t_pred, method = "KM")
  true_tdAUC = roc_obj_t$AUC
  
  
  #### Brier Score
  survival_table_tis = survival_table |> mutate(Age_Death = Age_Death - Age_Entry)
  assign("survival_table_tis", survival_table_tis, envir = .GlobalEnv)
  t_pred_b <- median(survival_table_tis$Age_Death[survival_table_tis$Death == 1])
  fit_cox_t = coxph(Surv(Age_Death, Death) ~ linpred_std, 
                       data = survival_table_tis)
  true_brier = brier(fit_cox_t, times = t_pred_b)$rsquared
  cindex_uno_t = concordance(fit_cox_t, timewt="n/G2")$concordance
  
  
  ####### Ridge
  
  #### C-Index
  pred_lp_dev_r <- predict(model_r, newx = slopematscaled, s = "lambda.min", 
                              type = "link")
  pred_lp_dev_r <- as.numeric(pred_lp_dev_r)
  survival_table$pred_lp_dev_r = pred_lp_dev_r
  fit_lp_r <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_r, 
                       data = survival_table)
  cindex_r = summary(fit_lp_r)$concordance
  
  #### tdAUC
  roc_obj_r <- survivalROC(Stime = survival_table$Age_Death, 
                         status = survival_table$Death,
                         entry = survival_table$Age_Entry,
                         marker = pred_lp_dev_r, 
                         predict.time = t_pred, method = "KM")
  auc_r = roc_obj_r$AUC
  
  
  #### Brier Score
  survival_table_tis$pred_lp_dev_r = pred_lp_dev_r
  fit_cox_r = coxph(Surv(Age_Death, Death) ~ pred_lp_dev_r, 
                       data = survival_table_tis)
  brier_r = brier(fit_cox_r, times = t_pred_b)$rsquared
  cindex_uno_r = concordance(fit_cox_r, timewt="n/G2")$concordance
  
  
  ####### Lasso
  
  c_l = sum(coef(model_l, s = "lambda.min") != 0)
  if(c_l == 0) {
    cindex_l = NA
    auc_l = NA
    brier_l = NA
    cindex_uno_l = NA
  } else {
    #### C-Index
    pred_lp_dev_l <- predict(model_l, newx = slopematscaled, 
                             s = "lambda.min", type = "link")
    pred_lp_dev_l <- as.numeric(pred_lp_dev_l)
    survival_table$pred_lp_dev_l = pred_lp_dev_l
    fit_lp_l <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_l, 
                      data = survival_table)
    cindex_l = summary(fit_lp_l)$concordance
    
    #### tdAUC
    roc_obj_l <- survivalROC(Stime = survival_table$Age_Death, 
                         status = survival_table$Death,
                         entry = survival_table$Age_Entry,
                         marker = pred_lp_dev_l, 
                         predict.time = t_pred, method = "KM")
    auc_l = roc_obj_l$AUC
    
    #### Brier Score
    survival_table_tis$pred_lp_dev_l = pred_lp_dev_l
    fit_cox_l = coxph(Surv(Age_Death, Death) ~ pred_lp_dev_l, 
                         data = survival_table_tis)
    brier_l = brier(fit_cox_l, times = t_pred_b)$rsquared
    cindex_uno_l = concordance(fit_cox_l, timewt="n/G2")$concordance
  }
  
  ####### Elastic Net
  c_e = sum(coef(model_e, s = "lambda.min") != 0)
  
  if(c_e == 0) {
    cindex_e = NA
    auc_e = NA
    brier_e = NA
    cindex_uno_e = NA
  } else {
    #### C-Index
    pred_lp_dev_e <- predict(model_e, newx = slopematscaled, 
                             s = "lambda.min", type = "link")
    pred_lp_dev_e <- as.numeric(pred_lp_dev_e)
    survival_table$pred_lp_dev_e = pred_lp_dev_e
    fit_lp_e <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_e, 
                      data = survival_table)
    cindex_e = summary(fit_lp_e)$concordance
    
    #### tdAUC
    roc_obj_e <- survivalROC(Stime = survival_table$Age_Death, 
                         status = survival_table$Death,
                         entry = survival_table$Age_Entry,
                         marker = pred_lp_dev_e, 
                         predict.time = t_pred, method = "KM")
    auc_e = roc_obj_e$AUC
    
    #### Brier Score
    survival_table_tis$pred_lp_dev_e = pred_lp_dev_e
    fit_cox_e = coxph(Surv(Age_Death, Death) ~ pred_lp_dev_e, 
                           data = survival_table_tis)
    brier_e = brier(fit_cox_e, times = t_pred_b)$rsquared
    cindex_uno_e = concordance(fit_cox_e, timewt="n/G2")$concordance
  }
  
  
  ####### Original PoA
  #### C-Index
  sum_score <- rowSums(slopesmatrixpoa)
  survival_table_poa$sum_score = sum_score
  fit_sum <- coxph(Surv(Age_Entry, Age_Death, Death) ~ sum_score, 
                   data = survival_table_poa)
  cindex_sum = summary(fit_sum)$concordance
  
  #### tdAUC
  roc_obj_s <- survivalROC(Stime = survival_table_poa$Age_Death, 
                         status = survival_table_poa$Death,
                         entry = survival_table_poa$Age_Entry,
                         marker = sum_score, 
                         predict.time = t_pred, method = "KM")
  auc_s = roc_obj_s$AUC
  
  #### Brier Score
  survival_table_tis_poa = survival_table_poa |> mutate(Age_Death = Age_Death - Age_Entry)
  assign("survival_table_tis_poa", survival_table_tis_poa, envir = .GlobalEnv)
  survival_table_tis_poa$sum_score = sum_score
  fit_cox_s = coxph(Surv(Age_Death, Death) ~ sum_score, 
                         data = survival_table_tis_poa)
  brier_s = brier(fit_cox_s, times = t_pred_b)$rsquared
  cindex_uno_s = concordance(fit_cox_s, timewt="n/G2")$concordance
  
  
  
  
    ############# Cross-validation
    k <- n_folds
    
    ids = unique(survival_table$id)
      
    
    foldsize <- floor(length(ids)/k)
    folds <- rep(1:k, each= foldsize)
    
    if(length(folds) < length(ids)){
      folds[(length(folds)+1):length(ids)] <- sample(1:k,
              length(ids) - length(folds))
    }
    # Store linear predictors and test set info across folds
    linpred_cv_r   <- numeric(length(ids))
    linpred_cv_l   <- numeric(length(ids))
    linpred_cv_e   <- numeric(length(ids))
    
    folds <- sample(folds)
    for(i in 1:k) {
      test_indices <- folds == i
      test_set_surv   <- survival_table[test_indices,]
      test_set_slopes  <- slopematscaled[test_indices,]
      train_set_surv  <- survival_table[!test_indices,]
      train_set_slopes <- slopematscaled[!test_indices,]

      surv_model_cv <- Surv(train_set_surv$Age_Entry, train_set_surv$Age_Death,
                            train_set_surv$Death)
      
      if (sum(train_set_surv$Death) == 0) {
        stop(paste("Fold", i, "has zero deaths in training set"))
      }

      ########### Ridge
