      lasso_cv <- suppressWarnings({cv.glmnet(train_set_slopes, surv_model_cv, 
                            family = "cox", alpha = 1)})
      linpred_cv_l[test_indices] <- as.numeric(predict(lasso_cv,
                                                       newx = test_set_slopes,
                                                       s = "lambda.min",
                                                       type = "link"))
      }
      ########### Elastic Net
      if(c_e != 0){
      en_cv <- suppressWarnings({cv.glmnet(train_set_slopes, surv_model_cv, 
                         family = "cox", alpha = 0.5)})
      linpred_cv_e[test_indices] <- as.numeric(predict(en_cv,
                                                       newx = test_set_slopes,
                                                       s = "lambda.min", 
                                                       type = "link"))
      }

    }
    
    # Performance measures in cross validated linear predictor
    t_pred_cv <- t_pred
    
    
    
    ########### Ridge
    survival_table$linpred_cv_r <- linpred_cv_r
    fit_cv_r       <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_cv_r, 
                            data = survival_table)
    c_index_cv_r   <- summary(fit_cv_r)$concordance
    roc_obj_cv_r   <- survivalROC(Stime = survival_table$Age_Death, 
                                  status = survival_table$Death,
                                  entry = survival_table$Age_Entry,
                                  marker = linpred_cv_r, 
                                  predict.time = t_pred_cv, method = "KM")
    tdauc_cv_r     <- roc_obj_cv_r$AUC
    
    survival_table_tis$linpred_cv_r = linpred_cv_r
    fit_cox_cv_r = coxph(Surv(Age_Death, Death) ~ linpred_cv_r, 
                         data = survival_table_tis)
    brier_cv_r = brier(fit_cox_cv_r, times = t_pred_b)$rsquared
    cindex_uno_cv_r = concordance(fit_cox_cv_r, timewt="n/G2")$concordance
    
    ########### Lasso
    if(c_l == 0){
      c_index_cv_l = NA
      tdauc_cv_l = NA
      brier_cv_l = NA
      cindex_uno_cv_l = NA
      
    } else {
      survival_table$linpred_cv_l <- linpred_cv_l
      fit_cv_l       <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_cv_l, 
