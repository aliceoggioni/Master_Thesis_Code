# From script
rgompertz_ph <- function(n, alpha, beta, linpred = 0){
  u <- runif(n)
  a <- alpha * exp(linpred)
  log(1 - log(u) * beta / a) / beta
}

  
# To simulate everything at once
simulate_all <- function(n = 500, # sample size
                         n_bio = 90,
                         times = c(1,2,3,4), # number of measurements
                         beta0 = rep(0, times = 3), # fixed intercept
                         beta1 = c(0, 0, 0), # fixed slope
                         beta2 = c(0.1, 0.1, 0.1), # fixed effect of quadratic term
                         beta3 = c(0.02, 0.02, 0.02), # fixed effect of cubic term
                         sigma_b0 = 1, # error for simulating random intercepts
                         sigma_b1 = 1, # error for simulating random slopes
                         alpha = exp(-9), beta = 0.085, # gompertz parameters
                         corr1 = 0, # latent factors
                         corr2 = 0.5, 
                         corr3 = -0.7 ,
                         alpha_cens = exp(-9), beta_cens = 0.085,
                         sigma_biom = 1 # biomarker-specific noise SD (after factor)
                         ){
  
  
  
  ids = rep(1:n, each = max(times))
  ages = numeric(length(ids))
  
  
    entryage = rnorm(length(unique(ids)), mean = 53, sd = 6)
    gaps = replicate(length(times) - 1, {rnorm(length(entryage), mean = 5, sd = 2)})
    bad = which(gaps <= 0)
    while(length(bad) > 0){
      gaps[bad] = rnorm(length(bad), 5, 2)
      bad = which(gaps <= 0)
    }
    gaps = as.data.frame(gaps)
    gaps$entryage = entryage
    gaps = gaps |> mutate(V1 = V1 + entryage, 
                          V2 = V1 + V2,
                          V3 = V2 + V3)
    gaps = relocate(gaps, entryage, .before = V1)
    for(i in seq_along(times)){
    id = seq(i, length(ids), by = length(times))
    ages[id] = gaps[,i]
    }
  
  
  ages_std = as.numeric(scale(ages))
  
  # assigning each biomarker to a latent factor
  
  n_per_factor <- n_bio / 3
  factor_assign <- rep(1:3, each = n_per_factor)

  bio_names <- paste0("bio", 1:n_bio)
  
  # correlation matrix for random effects (no correlation between any of them for now)
  D4 <- matrix(c(sigma_b0^2, 0,
                 0, sigma_b1^2), 2,2)
  
  b_F1 <- mvrnorm(n, mu = c(0, 0), Sigma = D4)  # col1=intercept, col2=slope
  b_F2 <- mvrnorm(n, mu = c(0, 0), Sigma = D4)  
  b_F3 <- mvrnorm(n, mu = c(0, 0), Sigma = D4) 
  
  b_F_list = list(b_F1, b_F2, b_F3)
  
  lambda_int   <- rnorm(n_bio, mean = 0, sd = 0.5)
  lambda_slope <- rnorm(n_bio, mean = 0, sd = 0.5)
  
  # Pre-allocate: total rows = n subjects × n_tp timepoints
  n_tp      <- length(times)
  n_rows    <- n * n_tp
  n_cols    <- 3 + n_bio  # id, time, age, bio1...bio250

  data_mat  <- matrix(NA, nrow = n_rows, ncol = n_cols)

  row_id <- 1  # keep track of which row we are filling

  
  
  for (i in 1:n) {   # loop over subjects
    for (j in times) {           # loop over timepoints

    t_j   <- times[j]
    age_j <- ages[(i - 1) * n_tp + j]
    age_j_std = ages_std[(i - 1) * n_tp + j]

    bio_vals <- numeric(n_bio)

    
    
    for (b in 1:n_bio) {
      k <- factor_assign[b]
    
      latent_score <- beta0[k] +
        lambda_int[b]   * b_F_list[[k]][i, 1] +
        lambda_slope[b] * (beta1[k] + b_F_list[[k]][i, 2]) * age_j_std +
        beta2[k]*age_j_std^2 + beta3[k]*age_j_std^3
    
      bio_vals[b] <- latent_score + rnorm(1, 0, sigma_biom)
    }

    # Fill the current row: id, time, age, then all biomarker values
    data_mat[row_id, ] <- c(i, t_j, age_j, bio_vals)
    row_id <- row_id + 1
  }
}

# Convert matrix to data frame and name the columns
data_long           <- as.data.frame(data_mat)
colnames(data_long) <- c("id", "time", "age", bio_names)
data_long$id        <- as.integer(data_long$id)

  
  # Simulate survival
  # Linear predictor: weighted sum of subject-specific slopes on each latent factor
  linpred <- corr1 * b_F1[, 2] + corr2 * b_F2[, 2] + corr3 * b_F3[, 2]
  linpred_std <- (linpred - mean(linpred)) / sd(linpred)

  # Draw age at death from Gompertz PH model
  age_death <- rgompertz_ph(n, alpha, beta, linpred_std)
  C_time <- rgompertz_ph(n, alpha_cens, beta_cens, linpred = 0)

  obs_time <- pmin(age_death, C_time)
  
  status   <- as.integer(age_death <= C_time)

  surv_data <- data.frame(
    id         = 1:n,
    Age_Death   = obs_time,
    Death     = status,
    linpred_std    = linpred_std,
    true_b1_F1 = b_F1[, 2],
    true_b1_F2 = b_F2[, 2],
    true_b1_F3 = b_F3[, 2]
  )
  
  
  # Exclude measurements after event time
  data_long = data_long |>
    left_join(surv_data[, c("id", "Age_Death")], by = "id") |>
      filter(age <= Age_Death) |>
      select(-Age_Death)
  
    list(
    longitudinal  = data_long,
    survival      = surv_data,
    factor_assign = factor_assign,
    true_b        = list(F1 = b_F1,
                         F2 = b_F2,
                         F3 = b_F3)
  )
  
}
