# Function with fitted values


```{r}
twostepcox_fitted = function(long_df, surv_df, landmark = "none", 
                             horizon = "none", cv = TRUE, n_folds = 5, 
                             seed = 9876,
                             analysis_name = "", threshold = 0.02,
                             verbose = FALSE){
  
  
  suppressMessages({
  suppressWarnings({
  
  ######## Creation dataset if landmark analysis
  if(landmark != "none"){
    
    rows_remove = which(long_df$age > landmark)
    long_df = long_df[-rows_remove,]
    ids_remove = names(which(table(long_df$id)<2))
    long_df = long_df[!(long_df$id %in% ids_remove),]
    ids_keep = unique(long_df$id[!(long_df$id %in% ids_remove)])
    surv_df = surv_df[surv_df$LLnr %in% ids_keep,]
    ids_remove2 = surv_df$LLnr[surv_df$Age_Death < landmark]
    surv_df = surv_df[!(surv_df$LLnr %in% ids_remove2),]
    long_df = long_df[!(long_df$id %in% ids_remove2),]
    
    entryage = long_df |> group_by(id) |> summarise(Age_Entry = max(age, na.rm = TRUE))
    surv_df$Age_Entry = NULL
    surv_df = left_join(surv_df, entryage, by = c("LLnr" = "id"))
    
    # Convert to time-in-study scale (time since landmark)
    # No left truncation: only Time_Death is used as the survival time
    surv_df$Time_Death = surv_df$Age_Death - landmark
  }
  
  
  ######## Summary statistics
  age_summary    = long_df |> group_by(timepoint) |> summarise_at(vars(age), mean)
  sex_summary    = count(long_df, timepoint, Sex)
  fasted_summary = count(long_df, timepoint, fasted)
  id_summary     = long_df |> group_by(timepoint) |> summarise_at(vars(id), n_distinct)
  maxcol_bio     = ncol(long_df) - 4
  corrmat        = cor(long_df[,2:maxcol_bio], use = "complete.obs")
  
  if(landmark != "none"){
    lastage = data.frame(id = surv_df$LLnr[surv_df$LLnr %in% long_df$id],
                         lastage = landmark)
  } else {
    lastage = data.frame(id = surv_df$LLnr[surv_df$LLnr %in% long_df$id],
                         lastage = surv_df$Age_Entry[surv_df$LLnr %in% long_df$id])
  }
  
  
  ######## LMMs
  fittedtable = data.frame(id = unique(long_df$id))
  for(i in 2:maxcol_bio){
    name = colnames(long_df)[i]
    f <- formula(paste(name, "~ (age|id) + age + Sex + fasted"))
    model <- lmer(f, data=long_df)
    coefs = coef(model)$id
    coefs$id = rownames(coefs)
    predtab = left_join(coefs, lastage, by = "id")
    newval = predtab$`(Intercept)` + predtab$Sex + predtab$fasted + predtab$age * predtab$lastage
    table_fit = as.data.frame(newval)
    colnames(table_fit) = name
    table_fit$id = rownames(coefs)
    fittedtable = full_join(table_fit, fittedtable, by = "id")
  }
  fittedtablecomplete = fittedtable[complete.cases(fittedtable),]
  fittedmatrix   = as.matrix(fittedtablecomplete[,c(1, 3:maxcol_bio)])
  fittedmatscaled = scale(fittedmatrix)
  fittedtableid  = as.data.frame(fittedmatscaled)
  fittedtableid$id = fittedtablecomplete$id
  
  if(verbose == TRUE){
    cat("\n","Fitted Values: done")
  }
  
  
  ######## Survival table
  survival_table = left_join(fittedtableid, surv_df, by = c("id" = "LLnr"))
  fittedmatscaled = as.matrix(survival_table[,c(colnames(fittedtableid), "Sex")])
  fittedmatscaled[,ncol(fittedmatscaled)] = as.numeric(fittedmatscaled[,ncol(fittedmatscaled)]) - 1
  fittedmatscaled = fittedmatscaled[,-(ncol(fittedmatscaled)-1)]
  fittedmatscaled <- apply(fittedmatscaled, 2, as.numeric)
  
  n_deaths = sum(survival_table$Death, na.rm = T)
  
  # In the landmark case: time-in-study, no left truncation (Time_Death only)
  # In the no-landmark case: age scale with left truncation (Age_Entry, Age_Death)
  if(landmark != "none"){
    t_event_col = survival_table$Time_Death
  } else {
    t_entry_col = survival_table$Age_Entry
    t_event_col = survival_table$Age_Death
  }
  
  # Surv object: no left truncation in landmark case
  if(landmark != "none"){
    surv_model = Surv(t_event_col, survival_table$Death)
  } else {
    surv_model = Surv(t_entry_col, t_event_col, survival_table$Death)
  }
  
  # Time-in-study table for Brier score (no left truncation in either case)
  if(landmark != "none"){
    survival_table_tis = survival_table |> mutate(Age_Death = Time_Death)
  } else {
    survival_table_tis = survival_table |> mutate(Age_Death = Age_Death - Age_Entry)
  }
  assign("survival_table_tis", survival_table_tis, envir = .GlobalEnv)
  
  penalty_factor <- rep(1, ncol(fittedmatscaled))
  penalty_factor[colnames(fittedmatscaled) == "Sex"] <- 0
  
  ######## Models
  model_r = cv.glmnet(fittedmatscaled, surv_model, family = "cox", 
                      penalty.factor = penalty_factor, alpha = 0)
  model_l = cv.glmnet(fittedmatscaled, surv_model, family = "cox", 
                      penalty.factor = penalty_factor, alpha = 1)
  model_e = cv.glmnet(fittedmatscaled, surv_model, family = "cox",
                      penalty.factor = penalty_factor, alpha = 0.5)
  
  
  ######## Set prediction horizons
  
  # t_pred: for C-index and tdAUC
  if(horizon == "none"){
    t_pred <- median(t_event_col[survival_table$Death == 1])
  } else {
    t_pred <- if(landmark != "none") horizon - landmark else horizon
  }
  
  # t_pred_b: for Brier score, always on time-in-study scale
  t_pred_b <- median(survival_table_tis$Age_Death[survival_table_tis$Death == 1])
  
  # Time points for tdAUC curve (no landmark only)
  if(landmark == "none"){
    t_seq <- quantile(t_event_col[survival_table$Death == 1],
                      probs = seq(0.1, 0.9, by = 0.1))
  }
  
  
  ######## Apparent Measures
  
  ####### Ridge
  
  #### C-Index
  pred_lp_dev_r <- as.numeric(predict(model_r, newx = fittedmatscaled,
                                      s = "lambda.min", type = "link"))
  survival_table$pred_lp_dev_r = pred_lp_dev_r
  if(landmark != "none"){
    fit_lp_r <- coxph(Surv(Time_Death, Death) ~ pred_lp_dev_r,
                      data = survival_table)
  } else {
    fit_lp_r <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_r,
                      data = survival_table)
  }
  cindex_r = summary(fit_lp_r)$concordance
  
  #### tdAUC
  if(landmark != "none" ){
    roc_obj_r <- survivalROC(Stime = t_event_col,
                             status = survival_table$Death,
                             marker = pred_lp_dev_r,
                             predict.time = t_pred, method = "KM")
  } else {
    roc_obj_r <- survivalROC(Stime = t_event_col,
                             status = survival_table$Death,
                             entry = t_entry_col,
                             marker = pred_lp_dev_r,
                             predict.time = t_pred, method = "KM")
  }
  auc_r = roc_obj_r$AUC
  
  #### Brier Score
  survival_table_tis$pred_lp_dev_r = pred_lp_dev_r
  fit_tis_r <- coxph(Surv(Age_Death, Death) ~ pred_lp_dev_r,
                     data = survival_table_tis)
  brier_r = brier(fit_tis_r, times = t_pred_b)$brier
  cindex_uno_r = concordance(fit_tis_r, timewt="n/G2")$concordance
  
  
  ####### Lasso
  
  c_l = sum(coef(model_l, s = "lambda.min") != 0)
  if(c_l == 0){
    cindex_l = NA; auc_l = NA; brier_l = NA; cindex_uno_l = NA
  } else {
    pred_lp_dev_l <- as.numeric(predict(model_l, newx = fittedmatscaled,
                                        s = "lambda.min", type = "link"))
    survival_table$pred_lp_dev_l = pred_lp_dev_l
    if(landmark != "none"){
      fit_lp_l <- coxph(Surv(Time_Death, Death) ~ pred_lp_dev_l,
                        data = survival_table)
    } else {
      fit_lp_l <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_l,
