                                    status = survival_table$Death,
                                    marker = linpred_cv_l,
                                    predict.time = t_pred_cv, method = "KM")
      } else {
        roc_obj_cv_l <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    entry = t_entry_col,
                                    marker = linpred_cv_l,
                                    predict.time = t_pred_cv, method = "KM")
      }
      tdauc_cv_l   <- roc_obj_cv_l$AUC
      fit_tis_cv_l <- coxph(Surv(Age_Death, Death) ~ linpred_cv_l,
                            data = survival_table_tis)
      brier_l_cv   <- brier(fit_tis_cv_l, times = t_pred_b_cv)$brier
      cindex_uno_cv_l = concordance(fit_tis_cv_l, timewt="n/G2")$concordance
    }
    
    ########### Elastic Net CV
    if(c_e == 0){
      c_index_cv_e = NA; tdauc_cv_e = NA; brier_e_cv = NA;  cindex_uno_cv_e = NA
    } else {
      survival_table$linpred_cv_e     <- linpred_cv_e
      survival_table_tis$linpred_cv_e <- linpred_cv_e
      if(landmark != "none"){
        fit_cv_e <- coxph(Surv(Time_Death, Death) ~ linpred_cv_e,
                          data = survival_table)
      } else {
        fit_cv_e <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_cv_e,
                          data = survival_table)
      }
      c_index_cv_e <- summary(fit_cv_e)$concordance
      if(landmark != "none"){
        roc_obj_cv_e <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    marker = linpred_cv_e,
                                    predict.time = t_pred_cv, method = "KM")
      } else {
        roc_obj_cv_e <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    entry = t_entry_col,
                                    marker = linpred_cv_e,
                                    predict.time = t_pred_cv, method = "KM")
      }
      tdauc_cv_e   <- roc_obj_cv_e$AUC
      fit_tis_cv_e <- coxph(Surv(Age_Death, Death) ~ linpred_cv_e,
                            data = survival_table_tis)
      brier_e_cv   <- brier(fit_tis_cv_e, times = t_pred_b_cv)$brier
      cindex_uno_cv_e = concordance(fit_tis_cv_e, timewt="n/G2")$concordance
    }
   
  }
  
  ########## tdAUC plots
  
  
  # tdAUC at multiple time points (no landmark only)
  if(landmark == "none"){
    tdauc_curve <- do.call(rbind, lapply(t_seq, function(t){
      auc_r_t <- survivalROC(Stime = t_event_col, status = survival_table$Death,
                             entry = t_entry_col, marker = linpred_cv_r,
                             predict.time = t, method = "KM")$AUC
      auc_l_t <- if(c_l == 0) NA else
                   survivalROC(Stime = t_event_col, status = survival_table$Death,
                               entry = t_entry_col, marker = linpred_cv_l,
                               predict.time = t, method = "KM")$AUC
      auc_e_t <- if(c_e == 0) NA else
                   survivalROC(Stime = t_event_col, status = survival_table$Death,
                               entry = t_entry_col, marker = linpred_cv_e,
                               predict.time = t, method = "KM")$AUC
      data.frame(time = t, Ridge = auc_r_t, Lasso = auc_l_t,
                 Elastic_Net = auc_e_t)
    }))
    
    tdauc_plot <- tdauc_curve |>
      pivot_longer(-time, names_to = "model", values_to = "tdAUC") |>
      mutate(model = recode(model, "Elastic_Net" = "Elastic Net")) |>
      ggplot(aes(x = time, y = tdAUC, colour = model)) +
      geom_line(linewidth = 0.8) +
      geom_point(size = 2) +
      geom_hline(yintercept = 0.5, linetype = "dashed", colour = "grey50") +
      scale_colour_manual(values = c("Ridge"       = "#3B8BD4",
                                     "Lasso"       = "#E24B4A",
                                     "Elastic Net" = "#F5A623")) +
      labs(x = "Time", y = "tdAUC", colour = NULL) +
      theme_minimal(base_size = 11) +
      theme(legend.position = "bottom",
            panel.grid.minor = element_blank())
  } else {
    tdauc_curve <- NULL
    tdauc_plot  <- NULL
  }
  
  
  
  
  ########## Coefficient plots
  if(landmark == "none"){
    
    coef_df = data.frame(
      biomarker   = as.factor(rownames(coef(model_r))),
      Ridge       = coef(model_r, s = "lambda.min")[,1],
      Lasso       = coef(model_l, s = "lambda.min")[,1],
      Elastic_net = coef(model_e, s = "lambda.min")[,1],
      row.names   = NULL
    )
    
    coef_df_long = coef_df |>
      pivot_longer(!biomarker, names_to = "model", values_to = "coefficient") |>
      mutate(biomarker_num = as.numeric(biomarker))
    
    coef_df_long <- coef_df_long |>
      mutate(model = recode(model, "Elastic_net" = "Elastic Net"),
             model = factor(model, levels = c("Ridge", "Lasso", "Elastic Net"))) |>
  filter(biomarker != "Sex")   # <-- drop the control variable here
    
    p <- ggplot(coef_df_long, aes(x = model, y = biomarker, fill = coefficient)) +
      geom_tile(linewidth = 0) +
      scale_fill_gradient2(
        low      = "#3B8BD4",
        mid      = "#F1EFE8",
        high     = "#E24B4A",
        midpoint = 0,
        name     = "Coefficient"
      ) +
      coord_cartesian(clip = "off") +
      scale_x_discrete(position = "top") +
      labs(x = NULL, y = NULL) +
      theme_minimal(base_size = 11) +
      theme(
        axis.text.x     = element_text(face = "bold"),
        axis.ticks.y    = element_blank(),
        panel.grid      = element_blank(),
        legend.position = "left"
      )
    
    if(maxcol_bio > 50){
      nonzero_biomarkers <- coef_df_long |>
        group_by(biomarker) |>
        summarise(max_abs = max(abs(coefficient))) |>
        filter((max_abs > threshold | max_abs < -threshold)) |>
        pull(biomarker)
      
      p <- p +
        scale_y_discrete(labels = function(x)
          ifelse(x %in% nonzero_biomarkers, x, "")) +
        theme(plot.margin = margin(5, 5, 5, 5),
              axis.text.y = element_text(size = 5))
    } else {
      p <- p +
        theme(plot.margin = margin(5, 5, 5, 5))
    }
  } else {
    p = NULL
  }
  
  
  apparent_models    = list(ridge = model_r, lasso = model_l, elastic_net = model_e)
  fitted_table       = fittedtableid
  summary_statistics = list(id = id_summary, age = age_summary,
                            sex = sex_summary, fasted = fasted_summary)
  
  if(cv == TRUE){
    results_table <- data.frame(
      Analysis = analysis_name,
      R_C    = cindex_r[1],    R_C_cv   = c_index_cv_r[1],
      R_unoC = cindex_uno_r, R_unoC_cv = cindex_uno_cv_r,
      R_auc  = auc_r,          R_auc_cv = tdauc_cv_r,
      R_B    = brier_r,        R_B_cv   = brier_r_cv,
      
      L_C    = cindex_l[1],    L_C_cv   = c_index_cv_l[1],
      L_unoC = cindex_uno_l, L_unoC_cv = cindex_uno_cv_l,
      L_auc  = auc_l,          L_auc_cv = tdauc_cv_l,
      L_B    = brier_l,        L_B_cv   = brier_l_cv,
      
      E_C    = cindex_e[1],    E_C_cv   = c_index_cv_e[1],
      E_unoC = cindex_uno_e, E_unoC_cv = cindex_uno_cv_e,
      E_auc  = auc_e,          E_auc_cv = tdauc_cv_e,
      E_B    = brier_e,        E_B_cv   = brier_e_cv
    )

    
    results = list(n_deaths = n_deaths, apparent_models = apparent_models,
                   fitted_table = fitted_table, survival_table = survival_table,
                   survival_table_tis = survival_table_tis,
                   results_table = results_table,
                   coef_plot = p,
                   summary_statistics = summary_statistics,
                   correlation_matrix = corrmat,
                   tdauc_curve = tdauc_curve,
                   tdauc_plot  = tdauc_plot)
    return(results)
    
  } else {
    
    results_table <- data.frame(
      Analysis = analysis_name,
      R_C   = cindex_r[1],
      R_auc = auc_r,
      R_B   = brier_r,
      
      L_C   = cindex_l[1],
      L_auc = auc_l,
      L_B   = brier_l,
      
      E_C   = cindex_e[1],
      E_auc = auc_e,
      E_B   = brier_e
    )
    
    results = list(n_deaths = n_deaths, apparent_models = apparent_models,
                   fitted_table = fitted_table, survival_table = survival_table,
                   survival_table_tis = survival_table_tis,
                   results_table = results_table,
                   coef_plot = p,
                   summary_statistics = summary_statistics,
                   correlation_matrix = corrmat,
                   tdauc_curve = tdauc_curve,
                   tdauc_plot  = tdauc_plot)
    return(results)
  }
  })
})

