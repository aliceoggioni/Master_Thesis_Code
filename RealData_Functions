# Function with Slopes

```{r}
twostepcox_slopes = function(long_df, surv_df, landmark = "none", 
                             horizon = "none", cv = TRUE, n_folds = 5, 
                             analysis_name = "", seed = 9876,
                             threshold = 0.02, verbose = FALSE){

  direction = read.csv("direction.csv")
  suppressMessages({
  suppressWarnings({
  
  ######## Creation dataset if landmark analysis
  if(landmark != "none"){
    
    # remove any longitudinal observations after landmark
    rows_remove = which(long_df$age > landmark)
    long_df = long_df[-rows_remove,]
    # remove individuals left with 1 observation (otherwise lmm will not fit)
    ids_remove = names(which(table(long_df$id)<2))
    long_df = long_df[!(long_df$id %in% ids_remove),]
    ids_keep = unique(long_df$id[!(long_df$id %in% ids_remove)])
    surv_df = surv_df[surv_df$LLnr %in% ids_keep,]
    # remove individuals who had an event before landmark
    ids_remove2 = surv_df$LLnr[surv_df$Age_Death < landmark]
    surv_df = surv_df[!(surv_df$LLnr %in% ids_remove2),]
    long_df = long_df[!(long_df$id %in% ids_remove2),]
    
    entryage = long_df |> group_by(id) |> summarise(Age_Entry = max(age, na.rm = TRUE))
    surv_df$Age_Entry = NULL
    surv_df = left_join(surv_df, entryage, by = c("LLnr" = "id"))
    
    # Convert to time-in-study scale (time since landmark)
    # No left truncation: only Time_Death is used as the survival time
    surv_df$Time_Death = surv_df$Age_Death - landmark
  }
    
  
  ######## Summary statistics
  age_summary    = long_df |> group_by(timepoint) |> summarise_at(vars(age), mean)
  sex_summary    = count(long_df, timepoint, Sex)
  fasted_summary = count(long_df, timepoint, fasted)
  id_summary     = long_df |> group_by(timepoint) |> summarise_at(vars(id), n_distinct)
  maxcol_bio     = ncol(long_df) - 4
  corrmat        = cor(long_df[,2:maxcol_bio], use = "complete.obs")
  
  ######## LMMs for PoA
  
  ##### Rescaling Biomarkers
  ldf = long_df[long_df$Sex == 2,2:maxcol_bio] 
  ldm = long_df[long_df$Sex == 1,2:maxcol_bio]
  ldf_scaled = as.data.frame(scale(ldf))
  ldf_scaled$id = long_df[long_df$Sex == 2,1]
  ldf_scaled$Sex = long_df[long_df$Sex == 2,"Sex"]
  ldf_scaled$age = long_df[long_df$Sex == 2,"age"]
  ldf_scaled$fasted = long_df[long_df$Sex == 2,"fasted"]
  ldm_scaled = as.data.frame(scale(ldm))
  ldm_scaled$id = long_df[long_df$Sex == 1,1]
  ldm_scaled$Sex = long_df[long_df$Sex == 1,"Sex"]
  ldm_scaled$age = long_df[long_df$Sex == 1,"age"]
  ldm_scaled$fasted = long_df[long_df$Sex == 1,"fasted"]
  ld_scaled = rbind(ldm_scaled, ldf_scaled)
  
  ##### Reversing direction for known ones
  for(i in 1:sum(colnames(ld_scaled) %in% direction$biomarker)){
    column = which(colnames(ld_scaled) %in% direction$biomarker)[i]
    name = colnames(ld_scaled)[column]
    ld_scaled[,column] = ld_scaled[,column] * direction$direction[direction$biomarker == name]
  }
  
  for(i in 1:sum(!(colnames(ldf) %in% direction$biomarker))){
    column = which(!(colnames(ld_scaled) %in% direction$biomarker))[i]
    name = colnames(ld_scaled)[column]
    corr = cor(ld_scaled[,column], ld_scaled$age, use = "complete.obs")
    sign_flip = if (corr > 0) 1 else -1
    ld_scaled[,column] = ld_scaled[,column] * sign_flip
  }
  
  
  ######## LMMs for PoA
  slopespoa = data.frame(id = unique(ld_scaled$id))
  for(i in 1:(maxcol_bio-1)){
    name = colnames(ld_scaled)[i]
    f <- formula(paste(name, "~ (age|id) + age + Sex + fasted"))
    model <- lmer(f, data=ld_scaled)
    raneftab = ranef(model)$id
    raneftab[,1] = NULL
    colnames(raneftab) = name
    raneftab$id = rownames(raneftab)
    slopespoa = full_join(raneftab, slopespoa, by = "id")
  }
  slopespoacomplete = slopespoa[complete.cases(slopespoa),]
  slopesmatrixpoa  = as.matrix(slopespoacomplete[,c(1, 3:maxcol_bio)])
  slopespoaid  = as.data.frame(slopesmatrixpoa)
  slopespoaid$id = slopespoacomplete$id
  
  
  
  ######## LMMs
  slopestable = data.frame(id = unique(long_df$id))
  for(i in 2:maxcol_bio){
    name = colnames(long_df)[i]
    f <- formula(paste(name, "~ (age|id) + age + Sex + fasted"))
    model <- lmer(f, data=long_df)
    raneftab = ranef(model)$id
    raneftab[,1] = NULL
    colnames(raneftab) = name
    raneftab$id = rownames(raneftab)
    slopestable = full_join(raneftab, slopestable, by = "id")
  }
  slopestablecomplete = slopestable[complete.cases(slopestable),]
  slopesmatrix  = as.matrix(slopestablecomplete[,c(1, 3:maxcol_bio)])
  slopematscaled = scale(slopesmatrix)
  slopestableid  = as.data.frame(slopematscaled)
  slopestableid$id = slopestablecomplete$id
  
  if(verbose == TRUE){
    cat("\n","LMMs: done")
  }
  
  
  ######## Survival table
  survival_table = left_join(slopestableid, surv_df, by = c("id" = "LLnr"))
  slopematscaled = as.matrix(survival_table[,c(colnames(slopestableid), "Sex")])
  slopematscaled[,ncol(slopematscaled)] = as.numeric(slopematscaled[,ncol(slopematscaled)]) - 1
  slopematscaled = slopematscaled[,-(ncol(slopematscaled)-1)]
  slopematscaled <- apply(slopematscaled, 2, as.numeric)
  
  
  survival_table_poa = left_join(slopespoaid, surv_df, by = c("id" = "LLnr"))
  n_deaths = sum(survival_table$Death, na.rm = T)
  
  # In the landmark case: time-in-study, no left truncation (Time_Death only)
  # In the no-landmark case: age scale with left truncation (Age_Entry, Age_Death)
  if(landmark != "none"){
    t_event_col = survival_table$Time_Death
    t_event_col_poa = survival_table_poa$Time_Death
  } else {
    t_entry_col = survival_table$Age_Entry
    t_event_col = survival_table$Age_Death
    
    t_entry_col_poa = survival_table_poa$Age_Entry
    t_event_col_poa = survival_table_poa$Age_Death
  }
  
  # Surv object: no left truncation in landmark case
  if(landmark != "none"){
    surv_model = Surv(t_event_col, survival_table$Death)
    surv_model_poa = Surv(t_event_col_poa, survival_table_poa$Death)
  } else {
    surv_model = Surv(t_entry_col, t_event_col, survival_table$Death)
    surv_model_poa = Surv(t_entry_col_poa, t_event_col_poa, survival_table_poa$Death)
  }
  
  # Time-in-study table for Brier score (no left truncation in either case)
  if(landmark != "none"){
    # Already in time-in-study scale
    survival_table_tis = survival_table |> mutate(Age_Death = Time_Death)
    survival_table_tis_poa = survival_table_poa |> mutate(Age_Death = Time_Death)
  } else {
    survival_table_tis = survival_table |> mutate(Age_Death = Age_Death - Age_Entry)
    survival_table_tis_poa = survival_table_poa |> mutate(Age_Death = Age_Death - Age_Entry)
  }
  assign("survival_table_tis", survival_table_tis, envir = .GlobalEnv)
  assign("survival_table_tis_poa", survival_table_tis_poa, envir = .GlobalEnv)
  
  penalty_factor <- rep(1, ncol(slopematscaled))
  penalty_factor[colnames(slopematscaled) == "Sex"] <- 0
  
  ######## Models
  model_r = cv.glmnet(slopematscaled, surv_model, penalty.factor = penalty_factor, 
                      family = "cox", alpha = 0)
  model_l = cv.glmnet(slopematscaled, surv_model, penalty.factor = penalty_factor, 
                      family = "cox", alpha = 1)
  model_e = cv.glmnet(slopematscaled, surv_model, penalty.factor = penalty_factor, 
                      family = "cox", alpha = 0.5)
  
  
  ######## Set prediction horizons
  
  # t_pred: for C-index and tdAUC
  if(horizon == "none"){
    t_pred <- median(t_event_col[survival_table$Death == 1])
  } else {
    t_pred <- horizon
  }
  
  # t_pred_b: for Brier score, always on time-in-study scale
  t_pred_b <- median(survival_table_tis$Age_Death[survival_table_tis$Death == 1])
  
  # Time points for tdAUC curve (no landmark only)
  if(landmark == "none"){
    t_seq <- quantile(t_event_col[survival_table$Death == 1],
                      probs = seq(0.1, 0.9, by = 0.1))
  }
  
  ######## Apparent Measures
  
  ####### Ridge
  
  #### C-Index
  pred_lp_dev_r <- as.numeric(predict(model_r, newx = slopematscaled,
                                      s = "lambda.min", type = "link"))
  survival_table$pred_lp_dev_r = pred_lp_dev_r
  if(landmark != "none"){
    fit_lp_r <- coxph(Surv(Time_Death, Death) ~ pred_lp_dev_r,
                      data = survival_table)
  } else {
    fit_lp_r <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_r,
                      data = survival_table)
  }
  cindex_r = summary(fit_lp_r)$concordance
  
  
  #### tdAUC
  if(landmark != "none"){
    roc_obj_r <- survivalROC(Stime = t_event_col,
                             status = survival_table$Death,
                             marker = pred_lp_dev_r,
                             predict.time = t_pred, method = "KM")
  } else {
    roc_obj_r <- survivalROC(Stime = t_event_col,
                             status = survival_table$Death,
                             entry = t_entry_col,
                             marker = pred_lp_dev_r,
                             predict.time = t_pred, method = "KM")
  }
  auc_r = roc_obj_r$AUC
  
  #### Brier Score
  survival_table_tis$pred_lp_dev_r = pred_lp_dev_r
  fit_tis_r <- coxph(Surv(Age_Death, Death) ~ pred_lp_dev_r,
                     data = survival_table_tis)
  brier_r = brier(fit_tis_r, times = t_pred_b)$brier
  cindex_uno_r = concordance(fit_tis_r, timewt="n/G2")$concordance
  
  ####### Lasso
  
  c_l = sum(coef(model_l, s = "lambda.min") != 0)
  if(c_l == 0) {
    cindex_l = NA
    auc_l    = NA
    brier_l  = NA
    cindex_uno_l = NA
  } else {
    #### C-Index
    pred_lp_dev_l <- as.numeric(predict(model_l, newx = slopematscaled,
                                        s = "lambda.min", type = "link"))
    survival_table$pred_lp_dev_l = pred_lp_dev_l
    if(landmark != "none"){
      fit_lp_l <- coxph(Surv(Time_Death, Death) ~ pred_lp_dev_l,
                        data = survival_table)
    } else {
      fit_lp_l <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_l,
                        data = survival_table)
    }
    cindex_l = summary(fit_lp_l)$concordance
    
    #### tdAUC
    if(landmark != "none"){
      roc_obj_l <- survivalROC(Stime = t_event_col,
                               status = survival_table$Death,
                               marker = pred_lp_dev_l,
                               predict.time = t_pred, method = "KM")
    } else {
      roc_obj_l <- survivalROC(Stime = t_event_col,
                               status = survival_table$Death,
                               entry = t_entry_col,
                               marker = pred_lp_dev_l,
                               predict.time = t_pred, method = "KM")
    }
    auc_l = roc_obj_l$AUC
    
    #### Brier Score
    survival_table_tis$pred_lp_dev_l = pred_lp_dev_l
    fit_tis_l <- coxph(Surv(Age_Death, Death) ~ pred_lp_dev_l,
                       data = survival_table_tis)
    brier_l = brier(fit_tis_l, times = t_pred_b)$brier
    cindex_uno_l = concordance(fit_tis_l, timewt="n/G2")$concordance
  }
  
  
  ####### Elastic Net
  
  c_e = sum(coef(model_e, s = "lambda.min") != 0)
  if(c_e == 0) {
    cindex_e = NA
    auc_e    = NA
    brier_e  = NA
    cindex_uno_e = NA
  } else {
    #### C-Index
    pred_lp_dev_e <- as.numeric(predict(model_e, newx = slopematscaled,
                                        s = "lambda.min", type = "link"))
    survival_table$pred_lp_dev_e = pred_lp_dev_e
    if(landmark != "none"){
      fit_lp_e <- coxph(Surv(Time_Death, Death) ~ pred_lp_dev_e,
                        data = survival_table)
    } else {
      fit_lp_e <- coxph(Surv(Age_Entry, Age_Death, Death) ~ pred_lp_dev_e,
                        data = survival_table)
    }
    cindex_e = summary(fit_lp_e)$concordance
    
    #### tdAUC
    if(landmark != "none"){
      roc_obj_e <- survivalROC(Stime = t_event_col,
                               status = survival_table$Death,
                               marker = pred_lp_dev_e,
                               predict.time = t_pred, method = "KM")
    } else {
      roc_obj_e <- survivalROC(Stime = t_event_col,
                               status = survival_table$Death,
                               entry = t_entry_col,
                               marker = pred_lp_dev_e,
                               predict.time = t_pred, method = "KM")
    }
    auc_e = roc_obj_e$AUC
    
    #### Brier Score
    survival_table_tis$pred_lp_dev_e = pred_lp_dev_e
    fit_tis_e <- coxph(Surv(Age_Death, Death) ~ pred_lp_dev_e,
                       data = survival_table_tis)
    brier_e = brier(fit_tis_e, times = t_pred_b)$brier
    cindex_uno_e = concordance(fit_tis_e, timewt="n/G2")$concordance
  }
  
  
  ####### Original PoA (Sum Score)
  
  #### C-Index
  sum_score <- rowSums(slopesmatrixpoa)
  survival_table_poa$sum_score = sum_score
  if(landmark != "none"){
    fit_sum <- coxph(Surv(Time_Death, Death) ~ sum_score,
                     data = survival_table_poa)
  } else {
    fit_sum <- coxph(Surv(Age_Entry, Age_Death, Death) ~ sum_score,
                     data = survival_table_poa)
  }
  cindex_sum = summary(fit_sum)$concordance
  
  #### tdAUC
  if(landmark != "none"){
    roc_obj_s <- survivalROC(Stime = t_event_col_poa,
                             status = survival_table_poa$Death,
                             marker = sum_score,
                             predict.time = t_pred, method = "KM")
  } else {
    roc_obj_s <- survivalROC(Stime = t_event_col_poa,
                             status = survival_table_poa$Death,
                             entry = t_entry_col_poa,
                             marker = sum_score,
                             predict.time = t_pred, method = "KM")
  }
  auc_s = roc_obj_s$AUC
  
  #### Brier Score
  survival_table_tis_poa$sum_score = sum_score
  fit_tis_s <- coxph(Surv(Age_Death, Death) ~ sum_score,
                     data = survival_table_tis_poa)
  brier_s = brier(fit_tis_s, times = t_pred_b)$brier
  cindex_uno_s = concordance(fit_tis_s, timewt="n/G2")$concordance
  
  if(verbose == TRUE){
    cat("\n", "Apparent measures: done")
  }
  
  
  ######## Cross-Validation
  
  if(cv == TRUE){
    if(verbose == TRUE){
      cat("\n", "Starting cross-validation")
    }
    
    k <- n_folds
    ids = unique(survival_table$id)
    foldsize <- floor(length(ids)/k)
    folds <- rep(1:k, each = foldsize)
    if(length(folds) < length(ids)){
      folds[(length(folds)+1):length(ids)] <- sample(1:k,
              length(ids) - length(folds))
    }
    
    linpred_cv_r   <- numeric(length(ids))
    linpred_cv_l   <- numeric(length(ids))
    linpred_cv_e   <- numeric(length(ids))
    linpred_cv_sum <- numeric(length(ids))
    
    set.seed(seed)
    folds <- sample(folds)
    
    for(i in 1:k) {
      test_indices     <- folds == i
      test_set_surv    <- survival_table[test_indices,]
      test_set_slopes  <- slopematscaled[test_indices,]
      train_set_surv   <- survival_table[!test_indices,]
      train_set_slopes <- slopematscaled[!test_indices,]
      
      # No left truncation in landmark case
      if(landmark != "none"){
        surv_model_cv <- Surv(train_set_surv$Time_Death, train_set_surv$Death)
      } else {
        surv_model_cv <- Surv(train_set_surv$Age_Entry, train_set_surv$Age_Death,
                              train_set_surv$Death)
      }
      
      ########### Ridge
      ridge_cv <- cv.glmnet(train_set_slopes, surv_model_cv,
                            family = "cox", alpha = 0)
      linpred_cv_r[test_indices] <- as.numeric(predict(ridge_cv,
                                                       newx = test_set_slopes,
                                                       s = "lambda.min",
                                                       type = "link"))
      
      ########### Lasso
      if(c_l != 0){
        lasso_cv <- cv.glmnet(train_set_slopes, surv_model_cv,
                              family = "cox", alpha = 1)
        linpred_cv_l[test_indices] <- as.numeric(predict(lasso_cv,
                                                         newx = test_set_slopes,
                                                         s = "lambda.min",
                                                         type = "link"))
      }
      
      ########### Elastic Net
      if(c_e != 0){
        en_cv <- cv.glmnet(train_set_slopes, surv_model_cv,
                           family = "cox", alpha = 0.5)
        linpred_cv_e[test_indices] <- as.numeric(predict(en_cv,
                                                         newx = test_set_slopes,
                                                         s = "lambda.min",
                                                         type = "link"))
      }
     
    }
    
    if(verbose == TRUE){
      cat("\n", "Cross validation: done")
    }
    
    t_pred_cv   <- t_pred
    t_pred_b_cv <- t_pred_b
    
    ########### Ridge CV
    survival_table$linpred_cv_r     <- linpred_cv_r
    survival_table_tis$linpred_cv_r <- linpred_cv_r
    if(landmark != "none"){
      fit_cv_r <- coxph(Surv(Time_Death, Death) ~ linpred_cv_r,
                        data = survival_table)
    } else {
      fit_cv_r <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_cv_r,
                        data = survival_table)
    }
    c_index_cv_r <- summary(fit_cv_r)$concordance
    if(landmark != "none"){
      roc_obj_cv_r <- survivalROC(Stime = t_event_col,
                                  status = survival_table$Death,
                                  marker = linpred_cv_r,
                                  predict.time = t_pred_cv, method = "KM")
    } else {
      roc_obj_cv_r <- survivalROC(Stime = t_event_col,
                                  status = survival_table$Death,
                                  entry = t_entry_col,
                                  marker = linpred_cv_r,
                                  predict.time = t_pred_cv, method = "KM")
    }
    tdauc_cv_r   <- roc_obj_cv_r$AUC
    fit_tis_cv_r <- coxph(Surv(Age_Death, Death) ~ linpred_cv_r,
                          data = survival_table_tis)
    brier_r_cv   <- brier(fit_tis_cv_r, times = t_pred_b_cv)$brier
    cindex_uno_cv_r = concordance(fit_tis_cv_r, timewt="n/G2")$concordance
    
    ########### Lasso CV
    if(c_l == 0){
      c_index_cv_l = NA
      tdauc_cv_l   = NA
      brier_l_cv   = NA
      cindex_uno_cv_l = NA
    } else {
      survival_table$linpred_cv_l     <- linpred_cv_l
      survival_table_tis$linpred_cv_l <- linpred_cv_l
      if(landmark != "none"){
        fit_cv_l <- coxph(Surv(Time_Death, Death) ~ linpred_cv_l,
                          data = survival_table)
      } else {
        fit_cv_l <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_cv_l,
                          data = survival_table)
      }
      c_index_cv_l <- summary(fit_cv_l)$concordance
      if(landmark != "none"){
        roc_obj_cv_l <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    marker = linpred_cv_l,
                                    predict.time = t_pred_cv, method = "KM")
      } else {
        roc_obj_cv_l <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    entry = t_entry_col,
                                    marker = linpred_cv_l,
                                    predict.time = t_pred_cv, method = "KM")
      }
      tdauc_cv_l   <- roc_obj_cv_l$AUC
      fit_tis_cv_l <- coxph(Surv(Age_Death, Death) ~ linpred_cv_l,
                            data = survival_table_tis)
      brier_l_cv   <- brier(fit_tis_cv_l, times = t_pred_b_cv)$brier
      cindex_uno_cv_l = concordance(fit_tis_cv_l, timewt="n/G2")$concordance
    }
    
    ########### Elastic Net CV
    if(c_e == 0){
      c_index_cv_e = NA
      tdauc_cv_e   = NA
      brier_e_cv   = NA
      cindex_uno_cv_e = NA
    } else {
      survival_table$linpred_cv_e     <- linpred_cv_e
      survival_table_tis$linpred_cv_e <- linpred_cv_e
      if(landmark != "none"){
        fit_cv_e <- coxph(Surv(Time_Death, Death) ~ linpred_cv_e,
                          data = survival_table)
      } else {
        fit_cv_e <- coxph(Surv(Age_Entry, Age_Death, Death) ~ linpred_cv_e,
                          data = survival_table)
      }
      c_index_cv_e <- summary(fit_cv_e)$concordance
      if(landmark != "none"){
        roc_obj_cv_e <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    marker = linpred_cv_e,
                                    predict.time = t_pred_cv, method = "KM")
      } else {
        roc_obj_cv_e <- survivalROC(Stime = t_event_col,
                                    status = survival_table$Death,
                                    entry = t_entry_col,
                                    marker = linpred_cv_e,
                                    predict.time = t_pred_cv, method = "KM")
      }
      tdauc_cv_e   <- roc_obj_cv_e$AUC
      fit_tis_cv_e <- coxph(Surv(Age_Death, Death) ~ linpred_cv_e,
                            data = survival_table_tis)
      brier_e_cv   <- brier(fit_tis_cv_e, times = t_pred_b_cv)$brier
      cindex_uno_cv_e = concordance(fit_tis_cv_e, timewt="n/G2")$concordance
    }
    
    ########### Sum Score CV
    linpred_cv_sum = sum_score
    c_index_cv_sum <- cindex_sum
    tdauc_cv_sum   <- auc_s
    brier_s_cv     <- brier_s
    cindex_uno_cv_s = cindex_uno_s
  }
  ########## tdAUC plot
  # tdAUC at multiple time points (no landmark only)
  if(landmark == "none"){
